# =====================================================================
# CareConfide — environment variables
# Copy this file to backend/.env and fill in real values.
# NEVER commit an actual .env file.
# =====================================================================

# --- Supabase (backend) ---
# If left blank, the backend automatically falls back to an in-memory
# demo data store so the app still runs for a hackathon demo.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI (backend only — never expose to the frontend) ---
# If left blank, the AI intake assistant automatically falls back to a
# deterministic "Demo AI mode" so the app never crashes.
AI_API_KEY=
AI_MODEL=claude-sonnet-4-6

# --- CORS ---
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173

# --- Frontend (Vite) ---
# Put this one in frontend/.env instead:
# VITE_API_URL=http://localhost:8000
